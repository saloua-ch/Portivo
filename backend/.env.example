# Supabase Project Settings -> Database -> Connection string -> URI
# (the direct Postgres connection, NOT the REST API URL / anon key)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Any long random string. Signs the login JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# Any long random string, separate from JWT_SECRET. Signs document download links.
FILE_SIGNING_SECRET=change-me-to-a-different-long-random-string

PORT=4000

# Origin the frontend is served from, for CORS.
CORS_ORIGIN=http://localhost:5173

# Where uploaded documents are written on disk.
UPLOAD_DIR=./uploads

# Used once by `npm run seed:admin` to create/update the login user.
SEED_ADMIN_EMAIL=soulef@genmaritime.net
SEED_ADMIN_PASSWORD=bendhibsoulef
